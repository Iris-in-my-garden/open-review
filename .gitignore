.idea/

# ==========================================
# uv & Python 虚拟环境与缓存
# ==========================================

# uv 默认创建的虚拟环境目录
.venv/

# uv 的本地项目缓存目录（如存在）
.uv/

# Python 字节码与运行时缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 本地仓库缓存（clone / worktree）
.cache/

# macOS 元数据文件
.DS_Store

# ==========================================
# 环境与密钥文件（重要）
# ==========================================

# 本地环境变量文件（包含 API Key 或数据库密码等敏感信息）
.env
.env.local
.env.*.local

# ==========================================
# 打包构建产物（如适用）
# ==========================================

build/
dist/
*.egg-info/

# ==========================================
# 评测产物（manifest 保留，原始数据/仓库/结果不提交）
# ==========================================
evaluation/.cache/
evaluation/results/
evaluation/metrics/